        <item name="colorOutlineVariant">#004347</item>

        <item name="android:statusBarColor">@color/magenta_bg</item>
        <item name="chatBubbleSentColor">#00B4C5</item>
        <item name="chatBubbleReceivedColor">#004347</item>
