<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ChatSnap" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_surface</item>

        <item name="colorTertiary">#E966FF</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_container_low</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOutline</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Custom Attributes -->
        <item name="chatBubbleSentColor">#DCF8C6</item>
        <item name="chatBubbleReceivedColor">@color/white</item>
        <item name="chatBubbleSentTextColor">@color/black</item>
        <item name="chatBubbleReceivedTextColor">@color/black</item>
        <item name="themeAccentColor">@color/primary</item>

        <item name="editTextStyle">@style/Widget.Material3.TextInputEditText.OutlinedBox</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="android:windowAnimationStyle">@style/Animation.Activity</item>
    </style>

    <style name="Animation.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Theme.ChatSnap" parent="Base.Theme.ChatSnap" />

    <style name="Theme.ChatSnap.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 1. Full Black Theme - Improved Visibility -->
    <style name="Theme.ChatSnap.FullBlack" parent="Base.Theme.ChatSnap">
        <item name="colorPrimary">@color/black_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/black_surface</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">#B0B0B0</item>
        <item name="colorTertiary">#E966FF</item>

        <item name="android:windowBackground">@color/black_bg</item>
        <item name="colorSurface">@color/black_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/black_primary</item>
        <item name="colorOnSurfaceVariant">#B0B0B0</item>
        <item name="colorOutlineVariant">#333333</item>

        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#B0B0B0</item>
        <item name="android:statusBarColor">@color/black_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/black_bg</item>

        <item name="chatBubbleSentColor">#303030</item>
        <item name="chatBubbleReceivedColor">#1E1E1E</item>
        <item name="chatBubbleSentTextColor">@color/white</item>
        <item name="chatBubbleReceivedTextColor">@color/white</item>
        <item name="themeAccentColor">@color/white</item>
    </style>

    <!-- 2. Full White Theme -->
    <style name="Theme.ChatSnap.FullWhite" parent="Base.Theme.ChatSnap">
        <item name="colorPrimary">@color/white_bg</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">#F5F5F5</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <item name="colorSecondary">#666666</item>
        <item name="colorTertiary">#810CA8</item>

        <item name="android:windowBackground">@color/white_bg</item>
        <item name="colorSurface">@color/white_bg</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurfaceVariant">#666666</item>

        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">#666666</item>
        <item name="android:statusBarColor">@color/white_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white_bg</item>

        <item name="chatBubbleSentColor">#E1FFC7</item>
        <item name="chatBubbleReceivedColor">#F0F0F0</item>
        <item name="chatBubbleSentTextColor">@color/black</item>
        <item name="chatBubbleReceivedTextColor">@color/black</item>
        <item name="themeAccentColor">@color/black</item>
    </style>

