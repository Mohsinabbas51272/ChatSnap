        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/emerald_surface</item>
        <item name="colorOnSurfaceVariant">#B0B0B0</item>
        <item name="colorOutlineVariant">#004D40</item>

        <item name="android:statusBarColor">@color/emerald_bg</item>
        <item name="chatBubbleSentColor">#1E3D40</item>
        <item name="chatBubbleReceivedColor">#004D40</item>
        <item name="chatBubbleSentTextColor">@color/white</item>
        <item name="chatBubbleReceivedTextColor">@color/white</item>
        <item name="themeAccentColor">@color/magenta_primary</item>
