<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Map Background Color (Light Map Slate/Cream) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E4E8EC" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Stylized Map Grid / Roads overlay using vector grid -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#D0D7DE" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Center Pin Drop Graphic -->
    <item
        android:width="44dp"
        android:height="44dp"
        android:gravity="center"
        android:drawable="@drawable/ic_location_pin_drop" />
</layer-list>
