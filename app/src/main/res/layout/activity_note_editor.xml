<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Top Action Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/editorToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="?attr/colorOnPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingEnd="16dp">

                <!-- Pin Toggle Button -->
                <ImageButton
                    android:id="@+id/btnTogglePin"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="?attr/colorOnPrimary"
                    android:contentDescription="Pin Note" />

                <!-- Favorite Toggle Button -->
                <ImageButton
                    android:id="@+id/btnToggleFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="?attr/colorOnPrimary"
                    android:contentDescription="Favorite Note" />

                <!-- Share Button -->
                <ImageButton
                    android:id="@+id/btnShareNote"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="?attr/colorOnPrimary"
                    android:contentDescription="Share Note" />

                <!-- Delete Button -->
                <ImageButton
                    android:id="@+id/btnDeleteNote"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="?attr/colorOnPrimary"
                    android:contentDescription="Delete Note" />

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Editor Canvas -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Category Picker Spinner layout -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/btnCategorySelect">

                <TextView
                    android:id="@+id/tvCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category: Others"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Note Title -->
            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Title"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@android:color/transparent"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="2"
                android:layout_marginBottom="12dp" />

            <!-- Note Date Display -->
            <TextView
                android:id="@+id/tvModifiedDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:alpha="0.7"
                android:layout_marginBottom="16dp"
                tools:text="Last modified: Today, 10:53 AM" />

            <!-- Note Description/Content -->
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type note contents here..."
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@android:color/transparent"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="6"
                android:gravity="top|start"
                android:layout_marginBottom="24dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginBottom="20dp" />

            <!-- Checklist Title Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Checklist"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddChecklistItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Item"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconSize="14dp"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>

            <!-- Checklist Items List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp" />

            <!-- Image Attachments Header -->
            <TextView
                android:id="@+id/tvImagesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Images"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Horizontal Image Attachments RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Document Attachments Header -->
            <TextView
                android:id="@+id/tvDocsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Document Attachments"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Document Attachments Layout Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDocs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Docked Control panel (Colors and Controls) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <!-- 1. Color Palette Selector list (Horizontal view) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp"
            android:background="?attr/colorSurfaceVariant">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Styling:"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="12dp" />

            <!-- Color Palette Options -->
            <LinearLayout
                android:id="@+id/layoutColorPalette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- 2. Attachment Tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Attachment"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Image Gallery Picker icon -->
            <ImageButton
                android:id="@+id/btnAttachGallery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Pick Image" />

            <!-- Camera capture icon -->
            <ImageButton
                android:id="@+id/btnAttachCamera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Take Photo" />

            <!-- Doc scan attach icon -->
            <ImageButton
                android:id="@+id/btnAttachDocument"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Attach Scanned Document" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
