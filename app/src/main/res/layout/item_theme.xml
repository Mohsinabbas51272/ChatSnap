<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/viewColorPreview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp">

        <!-- Small color circles preview -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#FF7F50" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#00BCD4" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#1ABC9C" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvThemeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Theme Name"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorPrimary" />

</LinearLayout>
