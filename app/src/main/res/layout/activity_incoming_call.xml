<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Decorative gradient overlay -->
    <View
        android:id="@+id/gradientOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_incoming_call_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Pulsing ring 1 (outer) -->
    <View
        android:id="@+id/pulseRing1"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_pulse_ring"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.32" />

    <!-- Pulsing ring 2 (middle) -->
    <View
        android:id="@+id/pulseRing2"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_pulse_ring"
        android:alpha="0.25"
        app:layout_constraintTop_toTopOf="@id/pulseRing1"
        app:layout_constraintBottom_toBottomOf="@id/pulseRing1"
        app:layout_constraintStart_toStartOf="@id/pulseRing1"
        app:layout_constraintEnd_toEndOf="@id/pulseRing1" />

    <!-- Caller Profile Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCallerAvatar"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_foreground"
        android:background="#2A2A2A"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
        app:strokeColor="#44FFFFFF"
        app:strokeWidth="3dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="@id/pulseRing1"
        app:layout_constraintBottom_toBottomOf="@id/pulseRing1"
        app:layout_constraintStart_toStartOf="@id/pulseRing1"
        app:layout_constraintEnd_toEndOf="@id/pulseRing1" />

    <!-- Call Type Label (Voice / Video) -->
    <TextView
        android:id="@+id/tvIncomingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Incoming Voice Call"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        android:letterSpacing="0.15"
        android:textAllCaps="true"
        app:layout_constraintTop_toBottomOf="@id/ivCallerAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Caller Name -->
    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="John Doe"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/tvIncomingLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ringing Status -->
    <TextView
        android:id="@+id/tvRingingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ringing..."
        android:textColor="#66FFFFFF"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tvCallerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call Timer (hidden until answered) -->
    <Chronometer
        android:id="@+id/callTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#99FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvCallerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Buttons Area -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Decline Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDecline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:backgroundTint="#FF3B30"
                app:tint="#FFFFFF"
                app:fabSize="normal"
                app:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Decline"
                android:textColor="#FF3B30"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Accept Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_call"
                app:backgroundTint="#34C759"
                app:tint="#FFFFFF"
                app:fabSize="normal"
                app:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Accept"
                android:textColor="#34C759"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
