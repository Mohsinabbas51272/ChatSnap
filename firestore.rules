rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /wallet/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /transactions/{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      match /streaks/{document=**} {
        allow read, write: if request.auth != null;
      }

      match /friends/{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /stories/{storyId} {
      allow read, write: if request.auth != null;
    }

    match /secretConversations/{docId} {
      allow read, write: if request.auth != null;
    }

    match /friendRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /friends/{friendId} {
      allow read, write: if request.auth != null;
    }

    match /typing/{conversationId} {
      allow read, write: if request.auth != null;
    }

    match /blocks/{blockId} {
      allow read, write: if request.auth != null;
    }

    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    match /groupMessages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /scheduledMessages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if request.auth != null;
    }

    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }

    match /highlights/{highlightId} {
      allow read, write: if request.auth != null;
    }

    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    match /aura_videos/{videoId} {
      allow read, write: if request.auth != null;
      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
    }

    match /video_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /config/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /supportRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null;
    }
  }
}
